# ============================================================
# Big V's Best Routes™ — Environment Variables Template
# Safety & Legal Compliance First Navigation Platform
# 4P3X Intelligent AI™ Created by Kyzel Kreates™
#
# RUN 11 — Supabase Live Backend Foundation
#
# INSTRUCTIONS:
#   1. Copy this file to .env.local in your project root
#   2. Fill in your actual values
#   3. Never commit .env.local to a public repository
#   4. Never share your Supabase anon key publicly if your RLS
#      policies are not properly configured
#
# SECURITY RULES:
#   - Only VITE_ prefixed variables are available in the browser
#   - Never add SUPABASE_SERVICE_ROLE_KEY here — it bypasses RLS
#   - Never add DATABASE_URL — backend only
#   - Never add JWT_SECRET — backend only
#   - The 4P3X API Config Guard™ blocks dangerous patterns in-app
# ============================================================

# ── Supabase (Run 11 — Required for Live Mode) ───────────────
# Your Supabase project URL (safe to include in frontend builds)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public key (safe for browser — RLS protects data)
# Found in: Supabase Dashboard → Settings → API → Project API keys → anon public
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# ── AI Providers (Optional — for AI chat features) ───────────
# Only add if using live AI provider features
# These are runtime keys stored in browser only — not synced
VITE_OPENAI_API_KEY=
VITE_OPENROUTER_API_KEY=
VITE_GROQ_API_KEY=
VITE_DEEPSEEK_API_KEY=
VITE_MISTRAL_API_KEY=
VITE_ANTHROPIC_API_KEY=
VITE_GEMINI_API_KEY=

# ── Routing Providers (Optional — Run 14) ─────────────────────
VITE_GRAPHHOPPER_API_KEY=

# ── Map Providers (Optional — future runs) ────────────────────
# Google Maps is a future optional provider after concept verification
# Do not add Google Maps keys in demo mode
# VITE_GOOGLE_MAPS_API_KEY=

# ============================================================
# NEVER ADD THESE — BACKEND ONLY:
#
# SUPABASE_SERVICE_ROLE_KEY   ← bypasses RLS — never in frontend
# DATABASE_URL                ← backend only
# JWT_SECRET                  ← backend only
# PRIVATE_KEY                 ← backend only
# WEBHOOK_SECRET              ← backend only
# STRIPE_SECRET_KEY           ← backend only
# AWS_SECRET_ACCESS_KEY       ← backend only
# FIREBASE_PRIVATE_KEY        ← backend only
# ============================================================
#
# RLS IS ENABLED ON ALL OPERATIONAL SUPABASE TABLES.
# Only frontend-safe anon/public configuration is allowed in the app.
# ============================================================
